# CropFusion - development environment template.
# Copy to .env and adjust. Values are Docker Compose interpolations and
# backend settings (BACKEND_*). Never commit the real .env.

# ------------------------------------------------------------------ data
POSTGRES_USER=cropfusion
POSTGRES_PASSWORD=cropfusion
POSTGRES_DB=cropfusion
REDIS_PASSWORD=

# ------------------------------------------------------------------ frontend
# Empty (default) = same-origin: nginx/Caddy proxy /api -> backend.
# Set to http://localhost:8000 only for a bare Vite dev server calling the API
# directly from a different origin.
VITE_API_BASE_URL=

# ------------------------------------------------------------------ backend
# SQLAlchemy async URL is assembled by compose from the values above.
BACKEND_DATABASE__URL=postgresql+asyncpg://cropfusion:cropfusion@localhost:5432/cropfusion
BACKEND_DATABASE__POSTGIS=true
BACKEND_SECURITY__SECRET_KEY=dev-only-secret-change-me

# ------------------------------------------------------------------ observability
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
MLOPS_INTERVAL_SECONDS=3600

# ------------------------------------------------------------------ devtools
PGADMIN_EMAIL=admin@cropfusion.local
PGADMIN_PASSWORD=admin
