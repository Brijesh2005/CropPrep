# ==========================
# Git
# ==========================
# Do NOT ignore Git metadata files like .gitignore or .gitattributes

# ==========================
# Python
# ==========================
__pycache__/
*.py[cod]
*$py.class

*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

.venv/
venv/
env/
ENV/

# ==========================
# Testing / Coverage
# ==========================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.benchmarks/
.bandit*

# ==========================
# Jupyter
# ==========================
.ipynb_checkpoints/

# ==========================
# Node.js
# ==========================
node_modules/
application/frontend/node_modules/
application/frontend/dist/
application/frontend/coverage/

# ==========================
# Environment Variables
# ==========================
.env
.env.*
!.env.example
!.env.production.example

# ==========================
# Datasets (Large Files)
# ==========================
application/backend/datasets/
training/datasets/raw/
training/datasets/.cropfusion/

# Generated datasets
**/datasets/*.csv
**/datasets/*.parquet

# GIS files
**/*.tif
**/*.tiff

# ==========================
# Model Artifacts
# ==========================
**/*.pt
**/*.pth
**/*.onnx
**/*.ckpt
**/*.h5
**/*.pkl
**/*.joblib

# NOTE:
# Do NOT ignore "models/" because it contains source code
# if your project has training/models/

# ==========================
# Logs
# ==========================
*.log
logs/
training/kaggle/logs/

# ==========================
# Backups
# ==========================
*.sql.gz
backups/

# ==========================
# Secrets
# ==========================
secrets/

# ==========================
# IDE
# ==========================
.idea/
.vscode/

# ==========================
# macOS
# ==========================
.DS_Store

# ==========================
# Claude
# ==========================
.claude/

# ==========================
# OS Temporary Files
# ==========================
Thumbs.db
Desktop.ini

# ==========================
# Kaggle Outputs
# ==========================
/kaggle/working/
training/kaggle/outputs/
training/kaggle/checkpoints/

# ==========================
# Keep Source Code
# ==========================
!training/models/**
!application/**
!training/**