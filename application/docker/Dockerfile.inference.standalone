# syntax=docker/dockerfile:1
# CropFusion inference-only worker (R1.4 architecture prep).
#
# Unlike Dockerfile.backend this image does NOT ship the Training Platform.
# It contains only the inference skeleton (`application/inference`), the GIS /
# history layers, the config templates, the `shared/` contract layer and the
# exported inference package + model weights (mounted or copied at deploy time).
#
# R1.4 status: the entrypoint is a placeholder that verifies the inference
# skeleton imports cleanly without any `training` dependency. The real serving
# entrypoint ships in a later phase.
#
# Build:
#   docker build -f Dockerfile.inference.standalone -t cropfusion/inference-standalone .
#
# Run (model + package mounted read-only):
#   docker run --rm \
#     -v "$(pwd)/application/models:/app/application/models:ro" \
#     -v "$(pwd)/application/inference_package:/app/application/inference_package:ro" \
#     cropfusion/inference-standalone

FROM python:3.14-slim AS runtime

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/application:/app \
    PORT=8000

WORKDIR /app/application

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# `shared/` is the only first-party code the inference runtime imports from
# the training stack; the training platforms themselves are excluded. It is
# used as a plain package via PYTHONPATH (no pip install required).
COPY shared/ /app/shared/

COPY application/inference/ /app/application/inference/
COPY application/inference_package/ /app/application/inference_package/
COPY application/models/ /app/application/models/
COPY application/gis/ /app/application/gis/
COPY application/history/ /app/application/history/
COPY application/config/ /app/application/config/
COPY application/database/ /app/application/database/

RUN addgroup --system cropfusion \
    && adduser --system --ingroup cropfusion cropfusion \
    && chown -R cropfusion:cropfusion /app

USER cropfusion

EXPOSE 8000

# R1.4 placeholder entrypoint: import every inference-layer package and print
# its version. Confirms the image is self-contained (no `training` import).
CMD ["python", "-c", "\nimport application.inference as inf\nimport application.inference_package as pkg\nimport application.gis as gis\nimport application.history as hist\nimport application.models as models\nprint('inference skeleton OK', inf.__version__, '| package artifacts:', len(pkg.INFERENCE_PACKAGE_FILES))\n"]
