# syntax=docker/dockerfile:1
# CropFusion documentation server.
#
# Builds a static HTML site from docs/ using scripts/build_docs.py, served by
# nginx.
#
# Build:
#   docker build -f Dockerfile.docs -t cropfusion/docs .

FROM python:3.12-slim AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir markdown pygments
COPY scripts/build_docs.py /build/build_docs.py
COPY docs/ /build/docs/
WORKDIR /build
RUN python build_docs.py --source docs --output /build/site

FROM nginx:1.31-alpine AS runtime

COPY --from=builder /build/site /usr/share/nginx/html
COPY application/docker/nginx/docs.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ || exit 1
