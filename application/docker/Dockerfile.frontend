# syntax=docker/dockerfile:1
# CropFusion frontend (React + Vite SPA) served by nginx.
#
# Build:
#   docker build -f Dockerfile.frontend -t cropfusion/frontend .

FROM node:20-alpine AS builder

WORKDIR /build

COPY application/frontend/package.json application/frontend/package-lock.json ./
RUN npm ci

COPY application/frontend/ .

ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ARG VITE_ENABLE_PWA=true
ENV VITE_ENABLE_PWA=${VITE_ENABLE_PWA}

RUN npm run build

FROM nginx:1.31-alpine AS runtime

COPY application/docker/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/healthz || exit 1
