# Data blobs pulled by Kaggle notebooks.
*.csv
*.parquet
*.db

# Model checkpoints / artifacts produced during experiments.
*.pt
*.pth
*.onnx
runs/
lightning_logs/

# Runtime workspace dirs (created by bootstrap / WorkspaceManager).
# NOTE: gitignore patterns are relative to THIS file, so use dir-local paths
# (a `training/kaggle/...` prefix here would match nothing).
logs/
outputs/
checkpoints/
cache/
configs/*.json

# Jupyter notebooks ignore the environment; the environment.yml is at repo root.
.env

# Python caches.
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
