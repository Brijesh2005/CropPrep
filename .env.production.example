# CropFusion - production environment template.
# Copy to .env, fill every value with a strong secret, then run
#   docker compose -f docker-compose.prod.yml up -d

# ------------------------------------------------------------------ domain
DOMAIN=cropfusion.app

# ------------------------------------------------------------------ data
POSTGRES_USER=cropfusion
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cropfusion
REDIS_PASSWORD=change-me

# Backend signing secret (64+ random bytes recommended).
BACKEND_SECURITY__SECRET_KEY=change-me-to-a-long-random-string

# ------------------------------------------------------------------ observability
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# ------------------------------------------------------------------ backups
BACKUP_RETENTION_DAYS=14
# Optional S3-compatible offsite target (leave empty to keep local only).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
