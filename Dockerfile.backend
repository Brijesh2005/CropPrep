# syntax=docker/dockerfile:1
# CropFusion API backend (FastAPI + uvicorn).
#
# Build:
#   docker build -f Dockerfile.backend -t cropfusion/backend .
#
# The runtime image carries the first-party packages
# (ai/*, services/*, quality/*) plus the backend application. The API and the
# embedded inference engine run in one process (see DEPLOYMENT.md).

FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc g++ build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Third-party wheels (torch, onnxruntime, pandas, rasterio, ...) are heavy, so
# build them once here and reuse the wheel set in the runtime stage.
RUN pip install --prefix=/build/wheels -r requirements.txt

FROM python:3.12-slim AS runtime

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/backend \
    PORT=8000

WORKDIR /app/backend

# rasterio/pyogrio wheels bundle GDAL; only OpenMP runtime is needed.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libgomp1 libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/wheels /usr/local

# First-party packages are installed from source so the image is always in
# sync with the working tree.
COPY ai/ /app/ai/
COPY quality/ /app/quality/
COPY services/ /app/services/
COPY backend/ /app/backend/

RUN pip install --no-cache-dir \
    /app/ai/models \
    /app/ai/preprocessing \
    /app/ai/training \
    /app/ai/explainability \
    /app/services/dataset_manager \
    /app/services/spatial_alignment

RUN addgroup --system cropfusion \
    && adduser --system --ingroup cropfusion cropfusion \
    && chown -R cropfusion:cropfusion /app

USER cropfusion

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS http://127.0.0.1:${PORT}/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
